# Vértice — Pessoas & Estratégia
# Configuração de Variáveis de Ambiente para Integração Vercel Serverless Function → Frappe CRM

# URL base da API do Frappe CRM (ex: http://localhost:8000 para local, ou https://crm.verticepessoas.com.br para produção)
FRAPPE_BASE_URL=http://localhost:8000

# Chaves de API de usuário de integração no Frappe (geradas via frappe.core.doctype.user.user.generate_keys)
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# (Opcional) Host Header para ambiente de desenvolvimento com Docker local onde o site responde em crm.localhost
FRAPPE_HOST_HEADER=crm.localhost
