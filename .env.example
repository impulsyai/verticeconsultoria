# Vértice — Pessoas & Estratégia
# Configuração do proxy server-side para o Vértice Hub

# Endpoint público de ingestão do Hub.
HUB_API_URL=http://localhost:3000/api/v1/public/site-intake

# Mesmo segredo configurado no Hub (SITE_INTAKE_SHARED_SECRET).
# Nunca exponha este valor no JavaScript do navegador.
SITE_INTAKE_SHARED_SECRET=

# Limite opcional do proxy local/serverless por IP.
RATE_LIMIT_MAX=30
